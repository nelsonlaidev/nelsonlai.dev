{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "futureFlags": {
    "watchUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**"]
    },
    "@repo/mdx-plugins#build": {
      "outputs": ["dist/**"]
    },
    "db:generate": {
      "cache": false,
      "interactive": true
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:seed": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "//#typecheck:root": {},
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "inputs": ["package.json"],
      "persistent": true,
      "interruptible": true
    },
    "env:check": {
      "cache": false
    },
    "env:generate": {
      "cache": false
    }
  },
  "globalEnv": ["SITE_URL", "UMAMI_URL", "UMAMI_WEBSITE_ID"],
  "globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
