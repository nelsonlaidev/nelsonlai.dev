{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "futureFlags": {
    "watchUsingTaskInputs": true
  },
  "globalEnv": ["!VITE_COMMIT_SHA"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "@repo/web#build": {
      "dependsOn": ["^build", "env:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!project.inlang/.gitignore", "!src/paraglide/**"],
      "env": [
        "AUTHOR_EMAIL",
        "BETTER_AUTH_URL",
        "CI",
        "GITHUB_CLIENT_ID",
        "GOOGLE_CLIENT_ID",
        "NODE_ENV",
        "R2_BUCKET",
        "R2_ENDPOINT",
        "R2_PUBLIC_URL",
        "RESEND_FROM_EMAIL",
        "SITE_URL",
        "SPOTIFY_CLIENT_ID",
        "UMAMI_URL",
        "UMAMI_WEBSITE_ID",
        "VITE_COMMIT_SHA"
      ],
      "passThroughEnv": [
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "DISCORD_WEBHOOK_URL",
        "GITHUB_CLIENT_SECRET",
        "GITHUB_TOKEN",
        "GOOGLE_API_KEY",
        "GOOGLE_CLIENT_SECRET",
        "IP_ADDRESS_SALT",
        "JWT_SECRET",
        "NELSONLAI_API_KEY",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "RESEND_API_KEY",
        "SPOTIFY_CLIENT_SECRET",
        "SPOTIFY_REFRESH_TOKEN",
        "UPSTASH_REDIS_REST_TOKEN",
        "UPSTASH_REDIS_REST_URL",
        "WAKATIME_API_KEY"
      ],
      "outputs": [".output/**", ".content-collections/generated/**", "src/paraglide/**"]
    },
    "@repo/mdx#build": {
      "outputs": ["dist/**"]
    },
    "storybook:build": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "db:generate": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": ["DATABASE_URL", "NODE_ENV"]
    },
    "db:migrate": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": ["DATABASE_URL", "NODE_ENV"]
    },
    "db:push": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": ["DATABASE_URL", "NODE_ENV"]
    },
    "db:seed": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "NODE_ENV"]
    },
    "db:reset": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": ["DATABASE_URL", "NODE_ENV"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL", "NODE_ENV"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "src/env.ts"]
    },
    "//#typecheck:root": {},
    "dev": {
      "cache": false,
      "dependsOn": ["^build", "env:generate"],
      "inputs": ["package.json"],
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": ["*"]
    },
    "env:check": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "env:generate": {
      "dependsOn": ["^env:generate"],
      "env": ["NODE_ENV"],
      "inputs": [".env.schema", "$TURBO_ROOT$/apps/web/.env.schema"],
      "outputs": ["src/env.ts"]
    },
    "i18n:check": {
      "cache": false
    }
  }
}
