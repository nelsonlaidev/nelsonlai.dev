{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "futureFlags": {
    "watchUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**"]
    },
    "@repo/mdx-plugins#build": {
      "outputs": ["dist/**"]
    },
    "db:generate": {
      "cache": false,
      "interactive": true
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:seed": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "//#typecheck:root": {},
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "inputs": ["package.json"],
      "persistent": true,
      "interruptible": true
    },
    "env:check": {
      "cache": false
    },
    "env:generate": {
      "cache": false
    }
  },
  "globalEnv": [
    "AUTHOR_EMAIL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CI",
    "CLOUDFLARE_R2_ACCESS_KEY_ID",
    "CLOUDFLARE_R2_BUCKET_NAME",
    "CLOUDFLARE_R2_ENDPOINT",
    "CLOUDFLARE_R2_PUBLIC_URL",
    "CLOUDFLARE_R2_SECRET_ACCESS_KEY",
    "DATABASE_URL",
    "DISCORD_WEBHOOK_URL",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GITHUB_TOKEN",
    "GOOGLE_API_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "IP_ADDRESS_SALT",
    "JWT_SECRET",
    "NELSONLAI_API_KEY",
    "NODE_ENV",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "SITE_URL",
    "SPOTIFY_CLIENT_ID",
    "SPOTIFY_CLIENT_SECRET",
    "SPOTIFY_REFRESH_TOKEN",
    "UMAMI_URL",
    "UMAMI_WEBSITE_ID",
    "UPSTASH_REDIS_REST_TOKEN",
    "UPSTASH_REDIS_REST_URL",
    "WAKATIME_API_KEY"
  ],
  "globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
