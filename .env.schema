# This file uses @env-spec: https://varlock.dev/env-spec
#
# @defaultRequired=true @defaultSensitive=true
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, icons=false)
# ----------

# Runtime environment used by Next.js and application code.
# @type=enum(development, test, production) @sensitive=false
NODE_ENV=development

# Whether commands are running in continuous integration.
# @type=boolean @sensitive=false
CI=false

# Vercel deployment environment used by the request proxy.
# @optional @type=enum(development, preview, production) @sensitive=false
VERCEL_ENV=

# Public Vercel deployment environment used to resolve preview URLs.
# @optional @type=enum(development, preview, production) @sensitive=false
NEXT_PUBLIC_VERCEL_ENV=

# Public Vercel branch hostname, without a protocol.
# @optional @sensitive=false
NEXT_PUBLIC_VERCEL_BRANCH_URL=

# Public URL of the website.
# Used for canonical URLs, metadata, and absolute links.
# @type=url @sensitive=false
# @example="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# Database
# ----------

# PostgreSQL connection string.
# @type=url(allowedProtocols=[postgres, postgresql])
# @example="postgres://postgres:postgres@localhost:5432/nelsonlaidev"
DATABASE_URL=


# Redis
# ----------

# Upstash Redis REST API endpoint.
# @type=url
# @docs(https://upstash.com/docs/redis)
# @example="http://localhost:8079"
UPSTASH_REDIS_REST_URL=

# Token used to authenticate with Upstash Redis.
# @example="local-uprest-token-7f3c9a2e6b1d4f80"
UPSTASH_REDIS_REST_TOKEN=


# Security
# ----------

# Secret salt used to hash IP addresses for post-like deduplication.
# Must remain secret and stable to preserve existing identifiers.
# @type=string(minLength=32)
# @example="random-passphrase-at-least-32-characters"
IP_ADDRESS_SALT=

# Secret used for Better Auth encryption and signing.
# Must be a high-entropy string of at least 32 characters.
# @type=string(minLength=32)
# @docs(https://www.better-auth.com/docs/installation)
# @example="super_secret_key_32_chars_minimum"
BETTER_AUTH_SECRET=


# Spotify
# ----------

# Spotify OAuth application client ID.
# @optional @sensitive=false
# @docs(https://developer.spotify.com/documentation/web-api)
SPOTIFY_CLIENT_ID=

# Spotify OAuth application client secret.
# @optional
SPOTIFY_CLIENT_SECRET=

# Refresh token used to access Spotify playback information.
# @optional
# @docs(https://developer.spotify.com/documentation/web-api/reference/get-the-users-currently-playing-track)
SPOTIFY_REFRESH_TOKEN=


# Dashboard - Statistics
# ----------

# Google API key used to fetch YouTube statistics.
# @optional
# @docs(https://developers.google.com/youtube/v3/getting-started)
GOOGLE_API_KEY=

# GitHub personal access token used to fetch GitHub statistics.
# @optional
# @docs(https://github.com/settings/tokens/new)
GITHUB_TOKEN=

# WakaTime API key used to fetch coding activity statistics.
# @optional
# @docs(https://wakatime.com/api-key)
WAKATIME_API_KEY=


# Authentication - Google OAuth
# ----------

# Google OAuth client ID.
# @optional @sensitive=false
GOOGLE_CLIENT_ID=

# Google OAuth client secret.
# @optional
GOOGLE_CLIENT_SECRET=


# Authentication - GitHub OAuth
# ----------

# GitHub OAuth application client ID.
# @optional @sensitive=false
# @docs(https://github.com/settings/applications/new)
GITHUB_CLIENT_ID=

# GitHub OAuth application client secret.
# @optional
GITHUB_CLIENT_SECRET=


# Nelson Lai API
# ----------

# API key used to authenticate requests to Nelson Lai API.
# @optional
# @docs(https://api.nelsonlai.dev)
NELSONLAI_API_KEY=


# Discord
# ----------

# Discord webhook URL used to send notifications.
# @optional @type=url
# @docs(https://discord.com/developers/docs/resources/webhook)
DISCORD_WEBHOOK_URL=


# Resend
# ----------

# Resend API key used to send transactional emails.
# @optional
# @docs(https://resend.com/docs)
RESEND_API_KEY=

# Sender email address, optionally including a display name, used for transactional emails.
# @sensitive=false
RESEND_FROM_EMAIL=

# Recipient email address used for new blog comment notifications.
# @optional @type=email @sensitive=false
AUTHOR_EMAIL=

# Secret used to sign and verify JWTs.
# @optional @type=string(minLength=32)
JWT_SECRET=


# Cloudflare R2
# ----------

# Cloudflare R2 S3-compatible API endpoint.
# Included in the public Content Security Policy.
# @optional @type=url @sensitive=false
# @docs(https://developers.cloudflare.com/r2/)
CLOUDFLARE_R2_ENDPOINT=

# Access key ID used to authenticate with Cloudflare R2.
# @optional
CLOUDFLARE_R2_ACCESS_KEY_ID=

# Secret access key used to authenticate with Cloudflare R2.
# @optional
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Name of the Cloudflare R2 storage bucket.
# @optional @sensitive=false
CLOUDFLARE_R2_BUCKET_NAME=

# Public URL used to access files stored in Cloudflare R2.
# @optional @type=url @sensitive=false
CLOUDFLARE_R2_PUBLIC_URL=


# Analytics - Umami
# ----------

# Public URL of the Umami analytics instance.
# @optional @type=url @sensitive=false
# @docs(https://umami.is/docs)
NEXT_PUBLIC_UMAMI_URL=

# Umami website identifier used for analytics tracking.
# @optional @type=uuid @sensitive=false
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
