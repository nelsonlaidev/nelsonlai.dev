{
  "name": "nelsonlai.dev",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:reset": "turbo run db:reset",
    "db:seed": "turbo run db:seed",
    "db:studio": "turbo run db:studio",
    "dev": "turbo watch dev",
    "email:dev": "pnpm --filter @repo/email email:dev",
    "email:export": "pnpm --filter @repo/email email:export",
    "env:check": "turbo run env:check",
    "env:generate": "turbo run env:generate",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "i18n:check": "turbo run i18n:check",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "readme:images": "turbo run readme:images",
    "spellcheck": "cspell lint --no-progress",
    "storybook": "pnpm --filter @repo/storybook storybook",
    "storybook:build": "turbo run storybook:build --filter=@repo/storybook",
    "test:e2e": "pnpm --filter @repo/web test:e2e",
    "test:e2e:inspector": "pnpm --filter @repo/web test:e2e:inspector",
    "test:e2e:install": "pnpm --filter @repo/web test:e2e:install",
    "test:e2e:ui": "pnpm --filter @repo/web test:e2e:ui",
    "test:unit": "turbo run test:unit",
    "test:unit:coverage": "pnpm --filter @repo/web test:unit:coverage",
    "test:unit:ui": "pnpm --filter @repo/web test:unit:ui",
    "test:unit:watch": "pnpm --filter @repo/web test:unit:watch",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit"
  },
  "devDependencies": {
    "@cspell/dict-es-es": "3.0.9",
    "@cspell/dict-pt-br": "2.4.4",
    "@eslint-react/eslint-plugin": "5.30.6",
    "@nelsonlaidev/oxfmt-config": "0.3.1",
    "@nelsonlaidev/oxlint-config": "1.3.0",
    "@nelsonlaidev/typescript-config": "catalog:",
    "cspell": "10.5.2",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.48.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "turbo": "2.11.13",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.23.0"
}
