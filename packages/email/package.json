{
  "name": "@repo/email",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "email:dev": "varlock run -- email dev --port 3001 --dir ./src/templates",
    "email:export": "varlock run -- email export --dir ./src/templates",
