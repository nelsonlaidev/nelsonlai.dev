    "env:generate": "varlock codegen",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "19.3.1",
    "react-email": "6.11.6",
    "resend": "6.33.0"
  },
  "devDependencies": {
    "@nelsonlaidev/typescript-config": "catalog:",
    "@react-email/ui": "6.11.6",
    "@total-typescript/ts-reset": "catalog:",
    "@types/node": "26.6.6",
    "@types/react": "catalog:",
    "@types/react-dom": "19.3.0",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
